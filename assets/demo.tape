Output assets/demo.gif
Output assets/demo.mp4

Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1200
Set Height 460
Set Padding 20
Set Theme "Catppuccin Mocha"
Set Framerate 24
Set TypingSpeed 60ms

Hide
Type "cd /tmp/pos-demo && clear && $HOME/.bun/bin/omp --no-session --no-title"
Enter
Sleep 18s
Show

Sleep 1s
Type "/style te"
Sleep 2s
Tab
Sleep 1500ms
Enter
Sleep 2500ms
Type "/style diagrams-first"
Sleep 1500ms
Escape
Sleep 400ms
Enter
Sleep 2500ms
Type "/style off"
Sleep 1200ms
Escape
Sleep 400ms
Enter
Sleep 3s
